{
  "manifest_version": 3,
  "name": "Aster YouTube Recovery",
  "version": "2.0.0",
  "description": "Keeps YouTube playback checkpoints and reports player failures to Aster.",
  "virtualized_browser_only": true,
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}