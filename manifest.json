{
  "manifest_version": 3,
  "name": "Aster YouTube Recovery",
  "version": "2.2.0",
  "description": "Diagnostics + YouTube playback checkpoints and error reporting for Aster.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://youtu.be/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}
